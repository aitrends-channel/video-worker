{
  "name": "video-worker-service",
  "version": "1.0.0",
  "description": "Background worker service for video generation and assembly",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o dist/yt-dlp && chmod +x dist/yt-dlp",
    "start": "node --max-old-space-size=150 --expose-gc dist/index.js",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "video",
    "worker",
    "bullmq",
    "ffmpeg"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@supabase/supabase-js": "^2.39.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20.10.6",
    "@upstash/redis": "^1.28.4",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
