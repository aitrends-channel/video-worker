# Server Configuration
NODE_ENV=production
PORT=3001

# Redis / Upstash Configuration
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx
UPSTASH_REDIS_HOST=xxxx.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=xxxxx
UPSTASH_REDIS_TLS=true

# Supabase Configuration
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# External API Keys
KIE_API_KEY=kie-xxxx
ELEVENLABS_API_KEY=sk_xxxx
ANTHROPIC_API_KEY=sk-ant-xxxx

# Public origin of the youtube-engine Next.js app. KIE POSTs video
# completion/failure webhooks here (-> /api/webhooks/kie/video), which
# surfaces terminal state in the UI within seconds instead of waiting
# for the worker's ~10s backstop poll. MUST be a public URL KIE can
# reach from their servers -- a localhost/127.0.0.1 value disables the
# webhook and every job (success AND failure) falls back to the slow
# poll loop. Falls back to APP_URL if unset. Leave unset only for local
# dev without a tunnel.
YOUTUBE_ENGINE_URL=https://your-app.vercel.app
